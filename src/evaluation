# src/evaluation.py

"""
Evaluation module.

Provides metrics used to compare models.
Macro F1 is prioritised because ESI classes
are imbalanced and rare classes are important.
"""


from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    f1_score,
    recall_score
)



def evaluate_model(model, X_test, y_test):

    """
    Evaluate a trained model.

    Returns:
        Dictionary containing evaluation metrics.
    """


    # Generate predictions
    predictions = model.predict(X_test)


    # Calculate macro F1 score
    # Each ESI class contributes equally
    macro_f1 = f1_score(
        y_test,
        predictions,
        average="macro"
    )


    # Calculate recall for ESI Level 1
    # Important because missing critical patients is high risk
    recall_esi1 = recall_score(
        y_test,
        predictions,
        labels=[1],
        average=None
    )[0]


    print(
        classification_report(
            y_test,
            predictions
        )
    )


    print(
        "Confusion Matrix:"
    )

    print(
        confusion_matrix(
            y_test,
            predictions
        )
    )


    results = {

        "macro_f1": macro_f1,

        "recall_ESI1": recall_esi1

    }


    return results
